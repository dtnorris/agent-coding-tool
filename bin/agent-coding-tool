#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
begin
  require "agent_coding_tool"
rescue AgentCodingTool::Bootstrap::Refused => error
  warn "ERROR: #{error.message}"
  exit 2
end

exit AgentCodingTool::CLI.run(ARGV, root: File.expand_path("..", __dir__))
